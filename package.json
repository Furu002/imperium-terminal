{
  "name": "imperium-terminal",
  "version": "1.10.1",
  "private": true,
  "type": "module",
  "description": "IMPERIUM — a local AI command terminal for Codex and Claude Code subscriptions.",
  "homepage": "https://github.com/Furu002/imperium-terminal",
  "main": "desktop/main.cjs",
  "author": "Sato Junichiro",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "terminal": "node terminal.mjs",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "build:installer": "electron-builder --win nsis --x64 --publish never",
    "build:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "build:linux": "electron-builder --linux deb AppImage --x64 --publish never",
    "icons": "node scripts/build-icons.mjs",
    "test": "node --test --test-timeout=60000 test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "4.6.1",
    "cytoscape": "3.35.0",
    "cytoscape-fcose": "2.2.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
